+FLASH_BAUD_DEFAULT = int(os.environ.get("CENTER_FLASH_BAUD", "1500000"))
+FLASH_BAUD_MIN = int(os.environ.get("CENTER_FLASH_BAUD_MIN", "9600"))
+FLASH_BAUD_MAX = int(os.environ.get("CENTER_FLASH_BAUD_MAX", "3000000"))
@@ -667,0 +671,41 @@ def camera_preview_step_for_serial_evidence(
+def validate_flash_baud(value: Any, source: str) -> int:
+    if isinstance(value, bool):
+        raise HTTPException(status_code=422, detail=f"{source} must be an integer baud rate")
+    try:
+        baud = int(value)
+    except (TypeError, ValueError) as exc:
+        raise HTTPException(status_code=422, detail=f"{source} must be an integer baud rate") from exc
+    if baud != value and not (isinstance(value, float) and value.is_integer()):
+        raise HTTPException(status_code=422, detail=f"{source} must be an integer baud rate")
+    if baud < FLASH_BAUD_MIN or baud > FLASH_BAUD_MAX:
+        raise HTTPException(
+            status_code=422,
+            detail=f"{source} must be between {FLASH_BAUD_MIN} and {FLASH_BAUD_MAX}",
+        )
+    return baud
+
+
+def flash_baud_for_task(payload: dict[str, Any], node: dict[str, Any]) -> int:
+    firmware = payload.get("firmware") or {}
+    if isinstance(firmware, dict) and firmware.get("flash_baud") is not None:
+        return validate_flash_baud(firmware["flash_baud"], "firmware.flash_baud")
+    target = payload.get("target_override") or node.get("target") or {}
+    if isinstance(target, dict) and target.get("flash_baud") is not None:
+        return validate_flash_baud(target["flash_baud"], "target.flash_baud")
+    return validate_flash_baud(FLASH_BAUD_DEFAULT, "CENTER_FLASH_BAUD")
+
+
+def apply_flash_baud(plan: list[dict[str, Any]], payload: dict[str, Any], node: dict[str, Any]) -> list[dict[str, Any]]:
+    default_baud = flash_baud_for_task(payload, node)
+    for index, step in enumerate(plan):
+        if step.get("op") != "flash":
+            continue
+        args = dict(step.get("args") or {})
+        if args.get("baud") is None:
+            args["baud"] = default_baud
+        else:
+            args["baud"] = validate_flash_baud(args["baud"], f"plan[{index}].args.baud")
+        step["args"] = args
+    return plan
+
+
