+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+from urllib.error import HTTPError
+from urllib.parse import parse_qs, urlparse
+
+
+SPEC = importlib.util.spec_from_file_location("review_observation_app", Path(__file__).parents[1] / "service/app.py")
+app = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(app)
+FRAME = b"\x89PNG\r\n\x1a\nframe fixture"
+
+
+class ObservationTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.evidence = Path(temporary.name)
+        self.reviewer = app.Reviewer.__new__(app.Reviewer)
+        self.reviewer.sim = Mock()
+        self.clock = 5000.0
+        self.calls = []
+        self.stop_at = float("inf")
+        self.frame_at = 0
+        self.serial_fault_at = float("inf")
+        self.crash_at = float("inf")
+        self.reviewer.sim.json.side_effect = self.sample_json
+        self.reviewer.sim.binary.side_effect = self.sample_frame
+
+    @property
+    def running_time(self):
+        return self.clock - 5000
+
+    def sleep(self, duration):
+        self.clock += duration
+
+    def sample_json(self, endpoint, timeout):
+        if "/serial?" in endpoint:
+            self.calls.append((self.running_time, "serial"))
+            if self.running_time >= self.serial_fault_at:
+                raise TimeoutError("serial transport timeout")
+            offset = int(parse_qs(urlparse(endpoint).query)["offset"][0])
+            serial = "APP_READY\n"
+            if self.running_time >= self.crash_at:
+                serial += "assert failed during observation\n"
+            return {"data": serial[offset:], "next_offset": len(serial)}
+        self.calls.append((self.running_time, "state"))
+        return {"state": "failed" if self.running_time >= self.stop_at else "running"}
+
+    def sample_frame(self, endpoint, timeout):
+        self.calls.append((self.running_time, "frame"))
+        if self.running_time < self.frame_at:
+            raise HTTPError(endpoint, 404, "frame unavailable", None, None)
+        return FRAME
+
+    def observe(self, features=None):
+        with (patch.object(app.time, "monotonic", side_effect=lambda: self.clock),
+              patch.object(app.time, "sleep", side_effect=self.sleep)):
+            return self.reviewer.observe_session("session", features or {"screenshot": True, "serial": True}, self.evidence)
+
+    def test_observes_full_window_with_fresh_reads_and_deduplicates_evidence(self):
+        record, frame, serial, session = self.observe()
+        self.assertEqual(record["status"], "PASS")
+        self.assertEqual(record["elapsed_seconds"], 60)
+        expected_times = list(range(0, 61, 5))
+        self.assertEqual([sample["elapsed_seconds"] for sample in record["samples"]], expected_times)
+        for key in ("frame", "serial"):
+            self.assertEqual([when for when, surface in self.calls if surface == key], expected_times)
+        self.assertEqual((frame, serial, session["state"]), (FRAME, "APP_READY\n", "running"))
+        self.assertEqual(record["serial_next_offset"], len(serial))
+        self.assertEqual(len(list(self.evidence.rglob("*.png"))), 1)
+        self.assertEqual((self.evidence / record["samples"][0]["frame_file"]).read_bytes(), FRAME)
+        self.assertEqual((self.evidence / record["samples"][0]["serial_file"]).read_text(), serial)
+
+    def test_aborts_early_on_session_exit_or_serial_transport_failure(self):
+        self.stop_at = 20
+        record, _, _, session = self.observe()
+        self.assertEqual((record["status"], record["elapsed_seconds"], self.running_time), ("PARTIAL", 15, 20))
+        self.assertEqual(session["state"], "failed")
+        self.assertNotIn((20, "frame"), self.calls)
+        self.clock, self.stop_at, self.serial_fault_at = 5000.0, float("inf"), 10
+        record, _, _, _ = self.observe()
+        self.assertEqual((record["status"], record["elapsed_seconds"], self.running_time), ("PARTIAL", 5, 10))
+        self.assertIn("transport timeout", record["error"])
+
+    def test_late_frame_does_not_shorten_observation_window(self):
+        self.frame_at = 15
+        record, _, _, _ = self.observe()
+        self.assertEqual((record["status"], record["elapsed_seconds"], self.running_time), ("PASS", 60, 75))
+        self.assertEqual([x["running_elapsed_seconds"] for x in record["samples"][:3]], [0, 5, 10])
+
+    def test_running_guest_without_frame_is_sampled_but_cannot_pass(self):
+        self.frame_at = float("inf")
+        record, _, serial, _ = self.observe()
+        self.assertEqual((record["status"], record["elapsed_seconds"], self.running_time), ("PARTIAL", 0, 60))
+        self.assertEqual(serial, "APP_READY\n")
+        self.assertEqual(len(record["samples"]), 13)
+        self.assertIn("did not produce a framebuffer", record["error"])
+
+    def test_serial_only_lane_and_crash_marker(self):
+        record, frame, serial, _ = self.observe({"serial": True})
+        self.assertEqual((record["status"], record["elapsed_seconds"], frame, serial),
+                         ("PASS", 60, b"", "APP_READY\n"))
+        self.clock, self.crash_at = 5000.0, 10
+        record, _, serial, _ = self.observe({"serial": True})
+        self.assertEqual((record["status"], self.running_time), ("PARTIAL", 10))
+        self.assertIn("assert failed", serial)
+        self.assertIn("assert failed", record["crash_marker"])
+
+
+class SubmissionObservationTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.evidence = Path(temporary.name)
+        self.runtime = app.Runtime.__new__(app.Runtime)
+        self.runtime.config = {"submit_enabled": True}
+        self.runtime.store, self.runtime.reviewer = Mock(), Mock()
+        self.job = {"status": "done", "passed": 1, "conclusion": "已通过", "version_id": "v",
+                    "evidence_dir": str(self.evidence), "declared_sha256": hashlib.sha256(b"image").hexdigest(),
+                    "declared_size": 5, "source_mode": "live_pending"}
+        self.runtime.store.job.return_value = self.job
+        self.runtime.reviewer.burner.json.side_effect = [
+            {"rows": [{"versionId": "v", "binFile": {"sha256": self.job["declared_sha256"], "fileSize": 5}}]},
+            {"msg": "submitted"},
+        ]
+
+    def test_positive_submission_requires_same_binary_and_sixty_seconds(self):
+        with self.assertRaisesRegex(RuntimeError, "至少 60 秒"):
+            self.runtime.submit_job("job")
+        record = {"status": "PASS", "review_id": "job", "source_sha256": "another-bin",
+                  "elapsed_seconds": 60, "samples": [{"elapsed_seconds": 0}, {"elapsed_seconds": 60}]}
+        path = self.evidence / "observation.json"
+        path.write_text(json.dumps(record))
+        with self.assertRaisesRegex(RuntimeError, "同一 BIN"):
+            self.runtime.submit_job("job")
+        record.update(source_sha256=self.job["declared_sha256"], elapsed_seconds=59.99)
+        path.write_text(json.dumps(record))
+        with self.assertRaisesRegex(RuntimeError, "至少 60 秒"):
+            self.runtime.submit_job("job")
+        self.runtime.reviewer.burner.json.assert_not_called()
+        record["elapsed_seconds"] = 60
+        path.write_text(json.dumps(record))
+        self.assertEqual(self.runtime.submit_job("job")["msg"], "submitted")
+
+    def test_negative_submission_keeps_existing_behavior_without_observation(self):
+        self.job.update(status="failed", passed=0, conclusion="固件未通过")
+        self.assertEqual(self.runtime.submit_job("job")["msg"], "submitted")
+        self.assertIs(self.runtime.reviewer.burner.json.call_args.args[2]["passed"], False)
+
+
+if __name__ == "__main__":
+    unittest.main()
