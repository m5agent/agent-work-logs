+    def observe_session(self, sid: str, features: Dict[str, Any], evidence: Path
+                        ) -> tuple[Dict[str, Any], bytes, str, Dict[str, Any]]:
+        """Sample a running board for the minimum wall-clock observation window."""
+        observation: Dict[str, Any] = {
+            "status": "PARTIAL", "scope": "running_virtual_device",
+            "required_seconds": MIN_VIRTUAL_OBSERVATION_SECONDS,
+            "elapsed_seconds": 0.0, "samples": [],
+        }
+        samples = observation["samples"]
+        first_sample = None
+        first_running = None
+        serial_offset = 0
+        serial_tail = ""
+        frame = b""
+        session: Dict[str, Any] = {}
+        endpoint = "/sessions/%s" % sid
+        captures = evidence / "observation"
+        captures.mkdir(parents=True, exist_ok=True)
+        try:
+            if not (features.get("screenshot") or features.get("serial")):
+                raise RuntimeError("device advertises neither framebuffer nor serial evidence")
+            while True:
+                session = self.sim.json(endpoint, timeout=5)
+                if session.get("state") != "running":
+                    raise RuntimeError("session state is %s" % (session.get("state") or "unknown"))
+                if first_running is None:
+                    first_running = time.monotonic()
+                sample: Dict[str, Any] = {"state": "running"}
+                if features.get("serial"):
+                    serial = self.sim.json(
+                        "%s/serial?offset=%d&limit=65536" % (endpoint, serial_offset), timeout=5,
+                    )
+                    chunk, next_offset = serial.get("data"), serial.get("next_offset")
+                    if not isinstance(chunk, str) or type(next_offset) is not int or next_offset < serial_offset:
+                        raise RuntimeError("invalid or reset serial stream cursor")
+                    sample["serial_offset"] = serial_offset
+                    sample["serial_next_offset"] = next_offset
+                    if chunk:
+                        serial_bytes = chunk.encode("utf-8")
+                        sample["serial_sha256"] = hashlib.sha256(serial_bytes).hexdigest()
+                        serial_path = captures / ("serial-%06d.log" % len(samples))
+                        serial_path.write_bytes(serial_bytes)
+                        sample["serial_file"] = str(serial_path.relative_to(evidence))
+                        serial_tail = (serial_tail + chunk)[-65536:]
+                    serial_offset = next_offset
+                    crash = self.crash_reason(serial_tail)
+                    if crash:
+                        observation["crash_marker"] = crash
+                        samples.append({**sample, "captured_at": utcnow(),
+                                        "elapsed_seconds": observation["elapsed_seconds"]})
+                        raise RuntimeError(crash)
+                if features.get("screenshot"):
+                    try:
+                        candidate = self.sim.binary(endpoint + "/frame.png", timeout=5)
+                    except urllib.error.HTTPError as exc:
+                        if exc.code != 404 or first_sample is not None:
+                            raise
+                        elapsed_running = time.monotonic() - first_running
+                        samples.append({**sample, "captured_at": utcnow(),
+                                        "running_elapsed_seconds": elapsed_running,
+                                        "frame_status": "NOT AVAILABLE"})
+                        if elapsed_running >= MIN_VIRTUAL_OBSERVATION_SECONDS:
+                            raise RuntimeError("running guest did not produce a framebuffer during startup observation")
+                        time.sleep(min(VIRTUAL_OBSERVATION_INTERVAL_SECONDS,
+                                       MIN_VIRTUAL_OBSERVATION_SECONDS - elapsed_running))
+                        continue
+                    if not candidate.startswith(b"\x89PNG\r\n\x1a\n"):
+                        raise RuntimeError("framebuffer did not return PNG data")
+                    frame = candidate
+                    digest = hashlib.sha256(frame).hexdigest()
+                    frame_path = captures / (digest + ".png")
+                    if not frame_path.exists():
+                        frame_path.write_bytes(frame)
+                    sample.update(frame_sha256=digest, frame_bytes=len(frame),
+                                  frame_file=str(frame_path.relative_to(evidence)))
+                now = time.monotonic()
+                if first_sample is None:
+                    first_sample = now
+                elapsed = now - first_sample
+                observation["elapsed_seconds"] = elapsed
+                samples.append({**sample, "captured_at": utcnow(), "elapsed_seconds": elapsed})
+                if elapsed >= MIN_VIRTUAL_OBSERVATION_SECONDS:
+                    # Confirm the guest stayed live while collecting the final sample.
+                    session = self.sim.json(endpoint, timeout=5)
+                    if session.get("state") != "running":
+                        raise RuntimeError("session ended while collecting the final observation sample")
+                    observation["status"] = "PASS"
+                    break
+                time.sleep(min(VIRTUAL_OBSERVATION_INTERVAL_SECONDS,
+                               MIN_VIRTUAL_OBSERVATION_SECONDS - elapsed))
+        except Exception as exc:
+            observation["error"] = str(exc)
+        observation["final_session_state"] = session.get("state")
+        observation["serial_next_offset"] = serial_offset
+        return observation, frame, serial_tail, session
