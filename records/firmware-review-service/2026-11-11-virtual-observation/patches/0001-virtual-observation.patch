+def keyboard_probe_keys(text: str, device_profile: Optional[str]) -> List[str]:
+    """Use explicit navigation and confirmation bindings from a keyboard legend."""
+    keys = []
+    legends = re.findall(r"^[ \t]*(?:[-*][ \t]+)?(?:\*\*)?keys[ \t]*:[ \t]*(?:\*\*)?([^\n]+)", text, re.M)
+    for legend in legends:
+        for binding in legend.split("·"):
+            names, separator, actions = binding.partition("=")
+            if not separator:
+                continue
+            names = names.split()
+            actions = [action.strip(" \t`*") for action in actions.split("/")]
+            if len(names) != len(actions):
+                continue
+            for name, action in zip(names, actions):
+                name = name.strip("`*")
+                if name in {"enter", "return"} and action in {"ok", "confirm", "select"}:
+                    keys.append("ret")
+                elif action in {"up", "down", "left", "right"} and name in KEYBOARD_NAVIGATION_QCODES:
+                    # Native Cardputer ADV QEMU generates its Fn+punctuation
+                    # matrix events from the corresponding arrow qcodes.
+                    if device_profile == "cardputer-adv" and CARDPUTER_ADV_NAVIGATION_KEYS.get(name) == action:
+                        keys.append(action)
+                    else:
+                        keys.append(KEYBOARD_NAVIGATION_QCODES[name])
+    return list(dict.fromkeys(keys))
+
