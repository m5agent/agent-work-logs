diff --git a/tests/test_virtual_startup.py b/tests/test_virtual_startup.py
new file mode 100644
index 0000000..7e34e4e
--- /dev/null
+++ b/tests/test_virtual_startup.py
@@ -0,0 +1,171 @@
+"""Exercise startup sequencing through the real review worker with a virtual clock."""
+
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+from urllib.error import HTTPError
+
+
+SPEC = importlib.util.spec_from_file_location(
+    "review_startup_app", Path(__file__).parents[1] / "service/app.py",
+)
+app = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(app)
+FRAME = b"\x89PNG\r\n\x1a\nframe fixture"
+SESSION = "/sessions/session"
+
+
+class StageAwareStartupTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.runtime = Path(temporary.name)
+        self.evidence = self.runtime / "jobs" / "job" / "evidence"
+        self.clock = 0
+        self.runs_at = 23
+        self.frame_at = 42
+        self.terminal_at = float("inf")
+        self.terminal_state = "failed"
+        self.serial_output = ""
+        self.calls = []
+        self.readiness_requests = []
+        self.firmware = b"fixture merged firmware"
+        self.digest = hashlib.sha256(self.firmware).hexdigest()
+        self.reviewer = app.Reviewer.__new__(app.Reviewer)
+        self.reviewer.runtime = self.runtime
+        self.reviewer.config = {}
+        self.reviewer.store = Mock()
+        self.reviewer.store.job.return_value = {"id": "job", "version_id": "version"}
+        self.reviewer.burner = Mock()
+        self.reviewer.burner.json.return_value = {"rows": [{
+            "versionId": "version", "firmwareId": "firmware", "firmwareName": "Startup demo",
+            "versionName": "1.0", "firmwareDescription": "A standalone animation demo.",
+            "deviceCodes": ["CARDPUTER_ADV"],
+            "binFile": {
+                "sha256": self.digest, "fileSize": len(self.firmware),
+                "downloadUrl": "https://fixture.invalid/firmware.bin",
+            },
+        }]}
+        self.reviewer.sim = Mock()
+        self.reviewer.sim.bytes.return_value = self.firmware
+        self.reviewer.sim.upload_artifact.return_value = {
+            "artifact_id": self.digest, "sha256": self.digest, "size": len(self.firmware),
+        }
+        self.reviewer.sim.json.side_effect = self.sim_json
+        self.reviewer.sim.binary.side_effect = self.sim_binary
+        self.reviewer.security_static_scan = Mock(return_value={"status": "REVIEW"})
+
+    def session(self):
+        if self.clock >= self.terminal_at:
+            state = self.terminal_state
+        elif self.clock >= self.runs_at:
+            state = "running"
+        elif self.runs_at - 4 <= self.clock:
+            state = "booting"
+        else:
+            state = "flashing"
+        return {"session_id": "session", "state": state, "display": {"width": 240, "height": 135}}
+
+    def sim_json(self, path, method="GET", payload=None, timeout=120):
+        self.calls.append((self.clock, method, path))
+        if path == "/devices":
+            return {"devices": [{
+                "device_id": "cardputer-adv", "creatable": True,
+                "features": {"flash": True, "serial": True, "screenshot": True, "input": True},
+            }]}
+        if path == "/firmware":
+            return {"firmware_id": "image", "source": {"artifact_id": self.digest}}
+        if path == "/firmware/analyze":
+            return {
+                "valid": True, "bootloader": {"valid": True}, "partition_table": {"valid": True},
+                "app_images": [{"valid": True, "label": "factory"}],
+            }
+        if path in {"/sessions", SESSION}:
+            return self.session()
+        if path == SESSION + "/wait":
+            state = self.session()["state"]
+            self.readiness_requests.append((self.clock, state, payload["timeout_seconds"]))
+            if state != "running" or self.clock < self.frame_at:
+                self.advance(payload["timeout_seconds"])
+                raise RuntimeError("simulator HTTP 408 ready_timeout: readiness not met")
+            return {"ready": True, "state": state, "ready_reason": ["frame_nonblank"]}
+        if path.startswith(SESSION + "/serial?"):
+            return {"data": self.serial_output, "next_offset": len(self.serial_output)}
+        if path == SESSION + "/input":
+            return {"accepted": True}
+        if path == SESSION + "/flash-snapshot":
+            return {"snapshot_id": str(self.clock)}
+        if path.startswith((SESSION + "/flash", SESSION + "/events", SESSION + "/logs")) or method == "DELETE":
+            return {}
+        raise AssertionError("unexpected simulator call: %s %s" % (method, path))
+
+    def sim_binary(self, path, timeout=120):
+        self.calls.append((self.clock, "GET", path))
+        if path == SESSION + "/frame.png":
+            if self.clock < self.frame_at:
+                raise HTTPError(path, 404, "frame unavailable", None, None)
+            return FRAME
+        if path.startswith(SESSION + "/evidence?"):
+            return b"fixture evidence"
+        raise AssertionError("unexpected binary read: %s" % path)
+
+    def advance(self, seconds):
+        self.clock += seconds
+        if self.clock > 230:
+            raise AssertionError("review exceeded its virtual test deadline")
+
+    def run_review(self):
+        intake = SimpleNamespace(kind="merged", provenance={})
+        # The wall clock stays fixed to exercise the monotonic startup deadline.
+        with (patch.object(app, "prepare_firmware", return_value=intake),
+              patch.object(app.time, "time", return_value=1000),
+              patch.object(app.time, "monotonic", side_effect=lambda: self.clock),
+              patch.object(app.time, "sleep", side_effect=self.advance)):
+            self.reviewer.run("job")
+        return self.reviewer.store.update_job.call_args.kwargs
+
+    def test_delayed_virtual_flash_precedes_readiness_and_live_408_keeps_observing(self):
+        result = self.run_review()
+        self.assertEqual(self.readiness_requests[0], (23, "running", 12))
+        self.assertGreaterEqual(self.readiness_requests[-1][0], self.frame_at + 60)
+        self.assertEqual((result["status"], result["lane"], result["passed"]), ("done", "SIM_VERIFIED", 1))
+        observation = json.loads((self.evidence / "observation.json").read_text())
+        self.assertEqual(observation["status"], "PASS")
+        self.assertGreaterEqual(observation["elapsed_seconds"], 60)
+
+    def test_terminal_startup_finishes_early_without_readiness_or_observation(self):
+        self.terminal_at = 5
+        self.terminal_state = "stopped"
+        result = self.run_review()
+        self.assertEqual(result["error_code"], "E_SIM_STARTUP_FAILED")
+        self.assertEqual((result["status"], result["lane"], result["passed"]), ("service_error", "SIM_PARTIAL", 0))
+        self.assertEqual(self.clock, 5)
+        self.assertEqual(self.readiness_requests, [])
+        self.assertTrue(any(method == "DELETE" for _, method, _ in self.calls))
+        self.assertFalse(any(call.args[1] == "observation_started" for call in self.reviewer.store.event.call_args_list))
+
+    def test_flashing_past_startup_budget_gets_timeout_distinct_from_exit(self):
+        self.runs_at = float("inf")
+        result = self.run_review()
+        self.assertEqual(result["error_code"], "E_SIM_STARTUP_TIMEOUT")
+        self.assertEqual((result["status"], result["lane"], result["passed"]), ("service_error", "SIM_PARTIAL", 0))
+        self.assertEqual(self.clock, 180)
+        self.assertEqual(self.readiness_requests, [])
+        self.assertTrue(any(method == "DELETE" for _, method, _ in self.calls))
+
+    def test_guest_watchdog_at_readiness_timeout_is_reported_as_virtual_crash(self):
+        self.serial_output = "Guru Meditation Error: Core  1 panic'ed (Interrupt wdt timeout on CPU1).\n"
+        result = self.run_review()
+        self.assertEqual(result["error_code"], "E_SIM_APP_CRASH")
+        self.assertEqual((result["status"], result["lane"], result["passed"]), ("manual_review", "SIM_PARTIAL", 0))
+        self.assertFalse(any(call.args[1] == "observation_started" for call in self.reviewer.store.event.call_args_list))
+        self.assertTrue(any(method == "DELETE" for _, method, _ in self.calls))
+
+
+if __name__ == "__main__":
+    unittest.main()
