+"""Regression coverage for review requirements and evidence attribution."""
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+
+
+SPEC = importlib.util.spec_from_file_location(
+    "firmware_review_app", Path(__file__).resolve().parents[1] / "service/app.py"
+)
+app = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(app)
+
+
+def claims(description):
+    return app.review_claims({"firmware_description": description})
+
+
+class ReviewClaimTests(unittest.TestCase):
+    def test_actual_grok_description_has_no_network_requirement_and_both_buttons(self):
+        # Exact relevant submitted wording from the 0.3.0 job, kept independent
+        # of the local task database and its private paths.
+        content = {
+            "firmware_name": "Grok Bot MultiFace · StopWatch",
+            "version_name": "0.3.0",
+            "firmware_description": (
+                "13 种角色、11 种颜色、12 种随机轮换表情的独立离线演示。"
+                "触摸控制头部和视线，IMU 支持相对姿态跟随，无需网络或账号。\n"
+                "- 左键 A 单击：切换角色（约 320 ms 延迟，用于区分双击）。\n"
+                "- 右键 B 单击：切换颜色。\n"
+                "- 双击 A：将当前姿态设为 IMU 中立位置，提示期间保持片刻静止。\n"
+                "- 同时按住 A+B 一秒：也可重新校准。\n"
+                "- 触摸或拖动：头和眼睛跟随手指，触摸优先于 IMU。\n"
+                "这是纯表情演示，说话和聆听是动画状态，不含语音识别、TTS 或联网功能。\n"
+                "感谢 [Grok Bot 网页参考实现](https://grokbot.yin.wiki/index.html) "
+                "提供的交互与视觉参考，感谢 [xAI Grok Bot](https://x.ai/bot) 的角色设计启发。\n"
+                "Special thanks to https://grokbot.yin.wiki/index.html for the visual reference."
+            ),
+        }
+        result = app.review_claims(content)
+        self.assertFalse(result["network_required"])
+        self.assertTrue(result["touch_required"])
+        self.assertTrue(result["button_required"])
+        self.assertEqual(result["required_buttons"], ["a", "b"])
+        self.assertFalse(result["ab_navigation_required"])
+
+    def test_negation_is_scoped_and_cannot_hide_positive_network_features(self):
+        for description in (
+            "离线演示，但支持联网获取天气。",
+            "无需网络即可启动；支持 MQTT 推送。",
+            "不支持 WiFi，但支持 Ethernet network。",
+            "Offline demo, with optional WiFi cloud synchronization.",
+            "No account required to use WiFi.",
+            "无需账号即可联网。",
+            "无需账号联网。",
+            "支持无线网络。",
+        ):
+            with self.subTest(description=description):
+                self.assertTrue(claims(description)["network_required"])
+
+    def test_negative_network_claims_and_reference_urls_do_not_require_network(self):
+        for description in (
+            "无需网络或账号。",
+            "不含语音识别、TTS 或联网功能。",
+            "No WiFi or cloud features.",
+            "Does not support network connectivity.",
+            "WiFi is not supported.",
+            "[Source](https://example.org/network/api) ![network](https://example.org/a.png)",
+            "参考 https://example.org/firmware 的本地绘图。",
+        ):
+            with self.subTest(description=description):
+                self.assertFalse(claims(description)["network_required"])
+
+    def test_word_fragments_do_not_invent_requirements(self):
+        result = claims("Rapid graphics and monkey artwork with a pushbuttonless enclosure.")
+        self.assertFalse(result["network_required"])
+        self.assertFalse(result["button_required"])
+
+    def test_explicit_button_forms_and_navigation(self):
+        for description in ("左键 A / 右键 B", "双击 A，长按 B", "同时按住 A+B", "Press A and B"):
+            with self.subTest(description=description):
+                result = claims(description)
+                self.assertTrue(result["button_required"])
+                self.assertEqual(result["required_buttons"], ["a", "b"])
+        self.assertTrue(claims("按键 A/B 用于上一页和下一页。")["ab_navigation_required"])
+        self.assertEqual(claims("Press A to select.")["required_buttons"], ["a"])
+
+
+class InteractionEvidenceTests(unittest.TestCase):
+    def setUp(self):
+        self.requirements = claims("触摸控制；左键 A 切换角色，右键 B 切换颜色。")
+
+    def test_touch_plan_does_not_suppress_claimed_buttons(self):
+        plan = app.Reviewer.input_plan({"touch": True, "width": 466, "height": 466},
+                                      {"input": True}, self.requirements)
+        self.assertEqual([name for name, _ in plan], ["touch_center", "drag_left", "key_a", "key_b"])
+
+    def test_touch_pass_does_not_mask_missing_or_rejected_button(self):
+        for key_b in (None, {"name": "key_b", "accepted": False, "frame_changed": True}):
+            results = [
+                {"name": "touch_center", "accepted": True, "frame_changed": True},
+                {"name": "key_a", "accepted": True, "frame_changed": True},
+            ]
+            if key_b:
+                results.append(key_b)
+            summary = app.Reviewer.interaction_summary(results, self.requirements)
+            self.assertEqual(summary["touch_status"], "PASS")
+            self.assertNotEqual(summary["button_status"], "PASS")
+            self.assertEqual(summary["status"], "PARTIAL")
+
+    def test_animated_frame_changes_cannot_prove_navigation_semantics(self):
+        results = [{"name": "key_" + key, "accepted": True, "frame_changed": True}
+                   for key in ("a", "b")]
+        summary = app.Reviewer.interaction_summary(results, claims("按键 A/B 翻页。"))
+        self.assertFalse(summary["ab_navigation_verified"])
+        self.assertEqual(summary["semantic_verification"], "NOT RUN")
+        self.assertEqual(summary["status"], "PARTIAL")
+
+    def run_serial_case(self, *, emit=True, change=True, options=None, baseline=True):
+        class FakeSim:
+            def __init__(self):
+                self.log = "shape=1 color=2\n" if baseline else "booted\n"
+                self.inputs = []
+                self.shape, self.color = 1, 2
+
+            def json(self, path, method="GET", payload=None, timeout=20):
+                if "/input" in path:
+                    self.inputs.append(dict(payload))
+                    if payload.get("action") in {None, "tap", "up"}:
+                        if change:
+                            if payload["key"] == "a":
+                                self.shape += 1
+                            else:
+                                self.color += 1
+                        if emit:
+                            self.log += "shape=%d color=%d\n" % (self.shape, self.color)
+                    return {"accepted": True}
+                from urllib.parse import parse_qs, urlparse
+                offset = int(parse_qs(urlparse(path).query)["offset"][0])
+                data = self.log.encode()[offset:]
+                return {"data": data.decode(), "bytes": len(data), "next_offset": offset + len(data)}
+
+            def binary(self, path, timeout=30):
+                return ("animated-frame-%d" % len(self.inputs)).encode()
+
+        sim = FakeSim()
+        reviewer = object.__new__(app.Reviewer)
+        reviewer.sim = sim
+        validation = {"input_assertions": {
+            "key_a": {"serial_pattern": r"shape=(?P<shape>\d+) color=(?P<color>\d+)",
+                      "group": "shape", "comparison": "changed", "unchanged_groups": ["color"],
+                      "timeout_seconds": 0},
+            "key_b": {"serial_pattern": r"shape=(?P<shape>\d+) color=(?P<color>\d+)",
+                      "group": "color", "comparison": "changed", "unchanged_groups": ["shape"],
+                      "timeout_seconds": 0},
+        }, "input_options": options or {}}
+        with tempfile.TemporaryDirectory() as directory:
+            jobdir = Path(directory)
+            (jobdir / "evidence").mkdir()
+            result = reviewer.interaction_test("test", "session", b"before", {"touch": False},
+                                              {"input": True}, claims("左键 A，右键 B。"),
+                                              jobdir, validation)
+            artifacts = sorted(path.name for path in (jobdir / "evidence").iterdir())
+        return result, sim.inputs, artifacts
+
+    def test_serial_assertions_verify_each_button_with_new_state_and_stable_other_field(self):
+        result, _, artifacts = self.run_serial_case()
+        self.assertEqual(result["status"], "PASS")
+        self.assertEqual(result["semantic_verification"], "PASS")
+        self.assertEqual(result["results"][0]["semantic_assertion"]["before"], "1")
+        self.assertEqual(result["results"][0]["semantic_assertion"]["after"], "2")
+        self.assertIn("interaction-key_b-serial-after.log", artifacts)
+
+    def test_missing_new_serial_or_unchanged_state_cannot_be_masked_by_animation(self):
+        for settings in ({"emit": False}, {"change": False}, {"baseline": False}):
+            result, _, _ = self.run_serial_case(**settings)
+            self.assertEqual(result["semantic_verification"], "PARTIAL")
+            self.assertEqual(result["status"], "PARTIAL")
+
+    def test_short_button_pulse_is_explicit_press_and_release(self):
+        result, requests, _ = self.run_serial_case(options={
+            "key_a": {"hold_seconds": 0.05, "settle_seconds": 0.05},
+            "key_b": {"hold_seconds": 0.05, "settle_seconds": 0.05},
+        })
+        self.assertEqual(result["semantic_verification"], "PASS")
+        self.assertEqual([(request["key"], request["action"], request["settle_seconds"])
+                          for request in requests],
+                         [("a", "down", 0.05), ("a", "up", 0.05),
+                          ("b", "down", 0.05), ("b", "up", 0.05)])
+
+
+if __name__ == "__main__":
+    unittest.main()
