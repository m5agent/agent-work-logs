--- /dev/null
+++ b/tests/test_frame_assertions.py
@@ -0,0 +1,151 @@
+"""Synthetic pixel oracles verify PNG decoding and bounded framebuffer assertions."""
+import importlib.util
+from pathlib import Path
+import struct
+import unittest
+import zlib
+
+
+SPEC = importlib.util.spec_from_file_location(
+    "frame_assertions", Path(__file__).resolve().parents[1] / "service/frame_assertions.py"
+)
+frames = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(frames)
+
+
+def chunk(kind, payload):
+    return (struct.pack(">I", len(payload)) + kind + payload +
+            struct.pack(">I", zlib.crc32(kind + payload) & 0xffffffff))
+
+
+def png(width, height, pixels, channels=3, row_filter=0, color_type=None, extra_raw=b""):
+    raw = bytearray()
+    previous = bytes(width * channels)
+    for y in range(height):
+        row = bytes(pixels[y * width * channels:(y + 1) * width * channels])
+        encoded = bytearray()
+        for x, value in enumerate(row):
+            left = row[x - channels] if x >= channels else 0
+            above = previous[x]
+            upper_left = previous[x - channels] if x >= channels else 0
+            if row_filter == 1:
+                predictor = left
+            elif row_filter == 2:
+                predictor = above
+            elif row_filter == 3:
+                predictor = (left + above) // 2
+            elif row_filter == 4:
+                estimate = left + above - upper_left
+                distances = [abs(estimate - candidate) for candidate in (left, above, upper_left)]
+                predictor = (left, above, upper_left)[distances.index(min(distances))]
+            else:
+                predictor = 0
+            encoded.append((value - predictor) & 255)
+        raw.append(row_filter)
+        raw.extend(encoded)
+        previous = row
+    header = struct.pack(">IIBBBBB", width, height, 8,
+                         color_type if color_type is not None else (2 if channels == 3 else 6), 0, 0, 0)
+    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) +
+            chunk(b"IDAT", zlib.compress(bytes(raw) + extra_raw)) + chunk(b"IEND", b""))
+
+
+def picture(color=(255, 0, 0), points=None, background=(0, 0, 0)):
+    points = points if points is not None else {(x, y) for x in range(2, 6) for y in range(2, 6)}
+    return png(8, 8, bytes(channel for y in range(8) for x in range(8)
+                           for channel in (color if (x, y) in points else background)))
+
+
+class FrameAssertionTests(unittest.TestCase):
+    def test_all_png_filters_decode_exact_rgb_and_rgba_pixels(self):
+        for channels in (3, 4):
+            pixels = bytes((index * 37 + index // 7) % 256 for index in range(7 * 5 * channels))
+            for filter_kind in range(5):
+                with self.subTest(channels=channels, filter=filter_kind):
+                    self.assertEqual(frames.decode_png(png(7, 5, pixels, channels, filter_kind)),
+                                     (7, 5, pixels, channels))
+
+    def test_palette_change_passes_without_claiming_silhouette_change(self):
+        before, after = picture(), picture((0, 255, 0))
+        config = {"type": "frame_palette_change", "min_foreground_pixels": 16}
+        result = frames.evaluate_frame_assertion(before, after, config)
+        self.assertEqual(result["status"], "PASS")
+        self.assertEqual(result["before_color"], [255, 0, 0])
+        self.assertEqual(result["after_color"], [0, 255, 0])
+        self.assertEqual(result["foreground_pixels_before"], 16)
+        result = frames.evaluate_frame_assertion(before, after, {"type": "frame_foreground_change"})
+        self.assertEqual(result["status"], "PARTIAL")
+        self.assertEqual(result["changed_fraction"], 0)
+
+    def test_mask_change_uses_exact_region_hamming_fraction(self):
+        old_points = {(x, y) for x in range(2, 6) for y in range(2, 6)}
+        new_points = {(x, y) for x in range(3, 7) for y in range(2, 6)}
+        result = frames.evaluate_frame_assertion(picture(points=old_points), picture(points=new_points), {
+            "type": "frame_foreground_change", "minimum_changed_fraction": 0.125,
+        })
+        self.assertEqual(result["status"], "PASS")
+        self.assertEqual(result["changed_pixels"], 8)
+        self.assertEqual(result["changed_fraction"], 8 / 64)
+        self.assertEqual(result["changed_foreground_fraction"], 8 / 20)
+
+    def test_small_eye_animation_does_not_meet_shape_threshold(self):
+        old_points = {(x, y) for x in range(2, 6) for y in range(2, 6)}
+        new_points = old_points - {(3, 3)}
+        config = {"type": "frame_foreground_change", "minimum_changed_fraction": 0.08,
+                  "min_foreground_pixels": 10}
+        result = frames.evaluate_frame_assertion(picture(points=old_points), picture(points=new_points), config)
+        self.assertEqual(result["status"], "PARTIAL")
+        self.assertEqual(result["changed_pixels"], 1)
+        self.assertEqual(frames.evaluate_frame_assertion(picture(), picture(), {
+            "type": "frame_palette_change",
+        })["status"], "PARTIAL")
+
+    def test_explicit_backgrounds_and_region_exclude_irrelevant_pixels(self):
+        before, after = picture(background=(7, 9, 8)), picture((0, 255, 0), background=(7, 9, 8))
+        result = frames.evaluate_frame_assertion(before, after, {
+            "type": "frame_palette_change", "background_colors": [[0, 0, 0], [7, 9, 8]],
+            "region": [2, 2, 4, 4],
+        })
+        self.assertEqual(result["status"], "PASS")
+        self.assertEqual(result["foreground_pixels_after"], 16)
+
+    def test_transparent_rgba_pixels_are_not_foreground(self):
+        before = png(2, 2, bytes([255, 0, 0, 0] * 4), channels=4)
+        after = png(2, 2, bytes([0, 255, 0, 0] * 4), channels=4)
+        result = frames.evaluate_frame_assertion(before, after, {
+            "type": "frame_palette_change", "min_foreground_pixels": 1,
+        })
+        self.assertEqual(result["status"], "PARTIAL")
+        self.assertEqual(result["foreground_pixels_before"], 0)
+
+    def test_corrupt_unsupported_or_inconsistent_png_never_passes(self):
+        valid = picture()
+        bad_crc = bytearray(valid)
+        bad_crc[-1] ^= 1
+        for malformed in (
+            b"not-png", valid[:-3], bytes(bad_crc),
+            valid[:33] + chunk(b"tRNS", bytes(6)) + valid[33:],
+            valid[:33] + chunk(b"acTL", struct.pack(">II", 1, 0)) + valid[33:],
+            png(8, 8, bytes(8 * 8 * 3), color_type=0),
+            png(8, 8, bytes(8 * 8 * 3), row_filter=5),
+            png(8, 8, bytes(8 * 8 * 3), extra_raw=b"unbounded trailing output"),
+            png(1, 1, bytes([255, 0, 0])),
+        ):
+            with self.subTest(length=len(malformed)):
+                result = frames.evaluate_frame_assertion(valid, malformed, {"type": "frame_palette_change"})
+                self.assertEqual(result["status"], "PARTIAL")
+
+    def test_invalid_configuration_never_passes(self):
+        for config in (
+            {"type": "unknown"},
+            {"type": "frame_palette_change", "region": [0, 0, 100, 100]},
+            {"type": "frame_palette_change", "background_colors": [[-1, 0, 0]]},
+            {"type": "frame_foreground_change", "minimum_changed_fraction": float("nan")},
+            {"type": "frame_foreground_change", "minimum_changed_fraction": 0},
+        ):
+            self.assertEqual(frames.evaluate_frame_assertion(picture(), picture((0, 255, 0)), config)["status"],
+                             "PARTIAL")
+
+
+if __name__ == "__main__":
+    unittest.main()
