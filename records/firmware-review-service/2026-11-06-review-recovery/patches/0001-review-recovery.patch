+def network_claim_present(text: str) -> bool:
+    """Keep positive clauses even when another clause explicitly says offline."""
+    clauses = re.split(r"[。！？!?;；，,\n]|\b(?:but|however|yet)\b|但是|不过|然而|但", text)
+    for clause in clauses:
+        for term in NETWORK_CLAIM_TERMS:
+            pattern = (r"(?<![a-z0-9_])%s(?![a-z0-9_])" % re.escape(term)
+                       if term.isascii() else re.escape(term))
+            for hit in re.finditer(pattern, clause):
+                prefix = clause[:hit.start()]
+                # Scope negation to this clause and stop at a new positive predicate.
+                negations = list(re.finditer(
+                    r"不(?:再)?(?:含|包括|支持|提供|需要|使用|具备|涉及)|无需|无须|没有|无(?!线)", prefix
+                ))
+                if negations:
+                    tail = prefix[negations[-1].end():]
+                    negative_list = bool(re.search(r"、|或|和|与|及", tail))
+                    direct_qualifier = bool(re.fullmatch(r"[\s:：]*(?:(?:任何|其他|额外|外部|在线|互联网|无线|移动|的)[\s]*)*", tail))
+                    if len(tail) <= 80 and (negative_list or direct_qualifier) and not re.search(
+                        r"即可|仍|也可|却|支持|提供|启用|连接|获取|发送|接收|访问|通过|可以|来|以便", tail
+                    ):
+                        continue
+                # English negation only covers network vocabulary, not e.g.
+                # 'no account required to connect to WiFi'.
+                english_negation = re.search(
+                    r"\b(?:no|without|(?:does\s+not|doesn't|do\s+not|not)\s+"
+                    r"(?:support|provide|include|require|use|need|have))\s+([^;.!?\n]{0,80})$", prefix
+                )
+                if english_negation:
+                    tail = english_negation.group(1)
+                    allowed = {
+                        "any", "a", "an", "the", "external", "internet", "online", "wireless",
+                        "or", "and", "wifi", "wi", "fi", "network", "networking", "cloud",
+                        "http", "https", "mqtt", "tcp", "udp", "dns", "api", "server",
+                    }
+                    if all(word in allowed for word in re.findall(r"[a-z]+", tail)):
+                        continue
+                suffix = clause[hit.end():]
+                if re.match(r"\s+(?:is\s+)?not\s+(?:supported|provided|included|used)\b", suffix):
+                    continue
+                return True
+    return False
+
