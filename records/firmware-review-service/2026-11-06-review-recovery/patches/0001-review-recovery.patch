+    def run_command(self, command: List[str], *, input: str, timeout: int) -> Any:
+        # The CLI may be a Node wrapper. Kill its native child too before retrying.
+        proc = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                stderr=subprocess.PIPE, text=True, start_new_session=True)
+        try:
+            stdout, stderr = proc.communicate(input, timeout=timeout)
+        except subprocess.TimeoutExpired:
+            try:
+                os.killpg(proc.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+            stdout, stderr = proc.communicate()
+            raise subprocess.TimeoutExpired(command, timeout, output=stdout, stderr=stderr)
+        return subprocess.CompletedProcess(command, proc.returncode, stdout, stderr)
+
+    @staticmethod
+    def failure_kind(output: str, timed_out: bool = False) -> str:
+        text = output.lower()
+        if timed_out:
+            return "E_CODEX_TIMEOUT"
+        if any(term in text for term in ("model_not_found", "model is not supported", "unsupported model")):
+            return "E_CODEX_MODEL_CONFIG"
+        if any(term in text for term in ("unauthorized", "authentication", "invalid_api_key", '"status":401', '"status": 401')):
+            return "E_CODEX_AUTH"
+        return "E_CODEX_EXECUTION"
 
