+def claim_term_present(text: str, term: str) -> bool:
+    """Match Latin words, not fragments such as API in 'rapid' or key in 'monkey'."""
+    if term.isascii():
+        return bool(re.search(r"(?<![a-z0-9_])%s(?![a-z0-9_])" % re.escape(term), text))
+    return term in text
+
