index 0000000..b276dcf
--- /dev/null
+++ b/service/frame_assertions.py
@@ -0,0 +1,148 @@
+"""Bounded PNG decoding and explicit framebuffer assertions, without image libraries."""
+from collections import Counter
+import hashlib
+import math
+import struct
+import zlib
+
+
+def decode_png(data):
+    """Return (width, height, RGB[A] bytes, channels); support PNG filters 0..4."""
+    if data[:8] != b"\x89PNG\r\n\x1a\n":
+        raise ValueError("invalid PNG signature")
+    position, header, compressed, ended = 8, None, bytearray(), False
+    while position < len(data):
+        if position + 12 > len(data):
+            raise ValueError("truncated PNG chunk")
+        length, kind = struct.unpack(">I4s", data[position:position + 8])
+        end = position + 12 + length
+        if end > len(data):
+            raise ValueError("truncated PNG payload")
+        payload = data[position + 8:end - 4]
+        crc = struct.unpack(">I", data[end - 4:end])[0]
+        if zlib.crc32(kind + payload) & 0xffffffff != crc:
+            raise ValueError("PNG CRC mismatch")
+        if header is None and kind != b"IHDR":
+            raise ValueError("PNG header must be first")
+        if kind == b"IHDR":
+            if header is not None or length != 13:
+                raise ValueError("invalid PNG header")
+            header = struct.unpack(">IIBBBBB", payload)
+        elif kind == b"IDAT":
+            compressed.extend(payload)
+        elif kind == b"IEND":
+            if length:
+                raise ValueError("invalid PNG end chunk")
+            ended = True
+            position = end
+            break
+        elif kind in {b"tRNS", b"acTL", b"fcTL", b"fdAT"}:
+            raise ValueError("PNG transparency keys and animation are unsupported")
+        elif kind != b"PLTE" and not kind[0] & 32:
+            raise ValueError("unsupported critical PNG chunk")
+        position = end
+    if not header or not ended or position != len(data):
+        raise ValueError("incomplete PNG")
+    width, height, depth, color, compression, filtering, interlace = header
+    if not (0 < width and 0 < height and width * height <= 16777216):
+        raise ValueError("PNG dimensions exceed supported bounds")
+    if depth != 8 or color not in (2, 6) or compression or filtering or interlace:
+        raise ValueError("only noninterlaced 8-bit RGB/RGBA PNG is supported")
+    channels = 3 if color == 2 else 4
+    stride = width * channels
+    expected = (stride + 1) * height
+    decoder = zlib.decompressobj()
+    raw = decoder.decompress(bytes(compressed), expected + 1)
+    if len(raw) != expected or not decoder.eof or decoder.unused_data:
+        raise ValueError("invalid PNG decompressed size")
+    pixels, previous = bytearray(), bytearray(stride)
+    for y in range(height):
+        row = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
+        filter_kind = raw[y * (stride + 1)]
+        if filter_kind > 4:
+            raise ValueError("unsupported PNG row filter")
+        for x in range(stride):
+            left = row[x - channels] if x >= channels else 0
+            above = previous[x]
+            upper_left = previous[x - channels] if x >= channels else 0
+            if filter_kind == 1:
+                predictor = left
+            elif filter_kind == 2:
+                predictor = above
+            elif filter_kind == 3:
+                predictor = (left + above) // 2
+            elif filter_kind == 4:
+                estimate = left + above - upper_left
+                distances = (abs(estimate - left), abs(estimate - above), abs(estimate - upper_left))
+                predictor = (left, above, upper_left)[distances.index(min(distances))]
+            else:
+                predictor = 0
+            row[x] = (row[x] + predictor) & 255
+        pixels.extend(row)
+        previous = row
+    return width, height, bytes(pixels), channels
+
+
+def evaluate_frame_assertion(before: bytes, after: bytes, config: dict) -> dict:
+    result = {"status": "PARTIAL", "scope": "framebuffer_assertion",
+              "before_sha256": hashlib.sha256(before).hexdigest(),
+              "after_sha256": hashlib.sha256(after).hexdigest()}
+    try:
+        kind = config.get("type")
+        if kind not in {"frame_palette_change", "frame_foreground_change"}:
+            raise ValueError("unsupported framebuffer assertion type")
+        result["scope"] = kind
+        width, height, old, old_channels = decode_png(before)
+        new_width, new_height, new, new_channels = decode_png(after)
+        if (width, height) != (new_width, new_height):
+            raise ValueError("framebuffer dimensions differ")
+        region = config.get("region", [0, 0, width, height])
+        if len(region) != 4 or any(type(value) is not int for value in region):
+            raise ValueError("region must contain four integers")
+        x, y, region_width, region_height = region
+        if min(x, y) < 0 or min(region_width, region_height) <= 0 or x + region_width > width or y + region_height > height:
+            raise ValueError("region falls outside framebuffer")
+        backgrounds = {tuple(value) for value in config.get("background_colors", [[0, 0, 0]])}
+        if any(len(value) != 3 or any(type(channel) is not int or not 0 <= channel <= 255 for channel in value)
+               for value in backgrounds):
+            raise ValueError("background_colors must contain RGB triples")
+        palettes, masks = [], []
+        for pixels, channels in ((old, old_channels), (new, new_channels)):
+            palette, mask = Counter(), bytearray()
+            for row in range(y, y + region_height):
+                for column in range(x, x + region_width):
+                    offset = (row * width + column) * channels
+                    rgb = tuple(pixels[offset:offset + 3])
+                    foreground = rgb not in backgrounds and (channels != 4 or pixels[offset + 3] != 0)
+                    mask.append(foreground)
+                    if foreground:
+                        palette[rgb] += 1
+            palettes.append(palette)
+            masks.append(mask)
+        counts = [sum(mask) for mask in masks]
+        result.update(region=list(region), foreground_pixels_before=counts[0], foreground_pixels_after=counts[1])
+        minimum = config.get("min_foreground_pixels", 16)
+        if type(minimum) is not int or minimum < 1:
+            raise ValueError("min_foreground_pixels must be a positive integer")
+        if min(counts) < minimum:
+            raise ValueError("insufficient foreground pixels")
+        if kind == "frame_palette_change":
+            colors = [palette.most_common(1)[0][0] for palette in palettes]
+            result.update(before_color=list(colors[0]), after_color=list(colors[1]))
+            passed = colors[0] != colors[1]
+        else:
+            changed = sum(a != b for a, b in zip(*masks))
+            union = sum(bool(a or b) for a, b in zip(*masks))
+            fraction = changed / len(masks[0])
+            threshold = float(config.get("minimum_changed_fraction", 0.08))
+            if not math.isfinite(threshold) or not 0 < threshold <= 1:
+                raise ValueError("minimum_changed_fraction must lie in (0, 1]")
+            result.update(changed_pixels=changed, region_pixels=len(masks[0]), changed_fraction=fraction,
+                          foreground_union_pixels=union, changed_foreground_fraction=changed / union,
+                          minimum_changed_fraction=threshold)
+            passed = fraction >= threshold
+        result["status"] = "PASS" if passed else "PARTIAL"
+        result["reason"] = "configured framebuffer change observed" if passed else "configured framebuffer change not observed"
+    except (ValueError, TypeError, KeyError, IndexError, struct.error, zlib.error) as exc:
+        result["reason"] = str(exc)
+    return result
