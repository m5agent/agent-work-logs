+import hashlib
+import importlib.util
+import json
+import sqlite3
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+spec = importlib.util.spec_from_file_location("review_replay_app", Path(__file__).parents[1] / "service/app.py")
+app = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(app)
+
+
+class SavedReviewTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.connections = []
+        original_connect = sqlite3.connect
+        def connect(*args, **kwargs):
+            connection = original_connect(*args, **kwargs)
+            self.connections.append(connection)
+            return connection
+        self.patcher = patch.object(app.sqlite3, "connect", side_effect=connect)
+        self.patcher.start()
+        self.addCleanup(self.patcher.stop)
+        self.addCleanup(lambda: [connection.close() for connection in self.connections])
+        self.runtime = app.Runtime.__new__(app.Runtime)
+        self.runtime.runtime_dir = Path(self.temp.name)
+        self.runtime.store = app.Store(Path(self.temp.name) / "state.db")
+        self.runtime.lock = threading.Lock()
+        self.runtime.pool = Mock()
+        self.runtime.config = {"submit_enabled": True}
+        self.runtime.reviewer = Mock()
+        self.data = b"same historical binary"
+        self.item = {"versionId": "v1", "firmwareId": "f1", "binFile": {
+            "sha256": hashlib.sha256(self.data).hexdigest(), "fileSize": len(self.data),
+        }}
+        self.jid = self.runtime.store.create_job("", self.item, False)
+        self.runtime.store.update_job(self.jid, status="manual_review")
+        self.jobdir = Path(self.temp.name) / "jobs" / self.jid
+        self.jobdir.mkdir(parents=True)
+        (self.jobdir / "firmware.bin").write_bytes(self.data)
+        (self.jobdir / "content.json").write_text('{"firmware_name":"saved"}')
+
+    def test_snapshot_retest_checks_hash_and_blocks_publishing(self):
+        result = self.runtime.retry_saved_job(self.jid, {"useCodex": True})
+        self.assertEqual(result["sourceMode"], "saved_snapshot")
+        self.assertEqual(self.runtime.store.job(self.jid)["source_mode"], "saved_snapshot")
+        with self.assertRaisesRegex(RuntimeError, "历史快照"):
+            self.runtime.submit_job(self.jid)
+        self.runtime.reviewer.burner.json.assert_not_called()
+        with self.assertRaises(ValueError):
+            self.runtime.retry_saved_job(self.jid, {})
+
+    def test_corrupt_cached_binary_is_never_queued(self):
+        (self.jobdir / "firmware.bin").write_bytes(b"changed")
+        with self.assertRaisesRegex(ValueError, "哈希"):
+            self.runtime.retry_saved_job(self.jid, {})
+        self.runtime.pool.submit.assert_not_called()
+
+    def test_completed_snapshot_can_be_replaced_by_live_pending_review(self):
+        self.runtime.store.update_job(self.jid, status="done", source_mode="saved_snapshot")
+        result = self.runtime.submit_jobs([self.item], "test", {"useCodex": True}, False)
+        self.assertEqual(result["jobIds"], [self.jid])
+        self.assertEqual(self.runtime.store.job(self.jid)["source_mode"], "live_pending")
+        self.assertEqual(self.runtime.store.job(self.jid)["status"], "queued")
+        self.runtime.pool.submit.assert_called_once()
+
+    def test_invalid_validation_rejected_before_queue_or_state_change(self):
+        for invalid in ["text", [1], {"input_options": []}, {"input_assertions": {"key_a": "wrong"}},
+                        {"input_options": {"key_a": {"hold_seconds": float("nan")}}}]:
+            with self.subTest(invalid=invalid):
+                with self.assertRaises(ValueError):
+                    self.runtime.retry_saved_job(self.jid, {"validation": invalid})
+                self.assertEqual(self.runtime.store.job(self.jid)["status"], "manual_review")
+        self.runtime.pool.submit.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
