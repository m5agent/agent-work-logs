+import importlib.util
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+
+spec = importlib.util.spec_from_file_location("review_service", Path(__file__).parents[1] / "service/app.py")
+app = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(app)
+
+
+class CodexRecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.workspace = Path(self.temp.name)
+        self.addCleanup(self.temp.cleanup)
+
+    def success(self, command, **kwargs):
+        output = Path(command[command.index("-o") + 1])
+        output.write_text(json.dumps({"verdict": "PASS", "reason": "内容合规"}))
+        return subprocess.CompletedProcess(command, 0, '\n'.join([
+            json.dumps({"type": "thread.started", "thread_id": "test-thread"}),
+            json.dumps({"type": "turn.completed", "usage": {"input_tokens": 10, "output_tokens": 4}}),
+        ]), "")
+
+    def test_explicit_route_and_recovery_after_transport_failure(self):
+        runner = app.CodexRunner("codex", {"codex_model": "review-model", "codex_model_provider": "configured",
+                                           "codex_ignore_user_config": True})
+        calls = []
+        def execute(command, **kwargs):
+            calls.append(command)
+            if len(calls) == 1:
+                return subprocess.CompletedProcess(command, 1, '{"type":"turn.failed","error":{"message":"connection reset"}}', "")
+            return self.success(command, **kwargs)
+        with patch.object(app.CodexRunner, "run_command", side_effect=execute), patch.object(app.time, "sleep"):
+            result = runner.content_review(self.workspace, {}, {})
+        self.assertTrue(result["ok"])
+        self.assertEqual(len(result["attempts"]), 2)
+        self.assertIn('model_provider="configured"', calls[1])
+        self.assertIn("--ignore-user-config", calls[1])
+        self.assertEqual(calls[1][calls[1].index("-m") + 1], "review-model")
+        self.assertEqual(result["usage"]["input_tokens"], 10)
+
+    def test_stale_pass_cannot_hide_failed_model_or_route(self):
+        (self.workspace / "content-last.json").write_text('{"verdict":"PASS","reason":"old"}')
+        failure = subprocess.CompletedProcess([], 1, '{"type":"turn.failed","error":{"message":"model_not_found"}}', "")
+        with patch.object(app.CodexRunner, "run_command", return_value=failure) as invoke:
+            result = app.CodexRunner("codex").content_review(self.workspace, {}, {})
+        self.assertFalse(result["ok"])
+        self.assertEqual(result["verdict"], "ERROR")
+        self.assertEqual(result["error_code"], "E_CODEX_MODEL_CONFIG")
+        self.assertEqual(invoke.call_count, 1)
+        self.assertFalse((self.workspace / "content-last.json").exists())
+
+    def test_only_configured_fallback_route_is_used(self):
+        calls = []
+        def execute(command, **kwargs):
+            calls.append(command)
+            if len(calls) == 1:
+                return subprocess.CompletedProcess(command, 1, '{"type":"turn.failed","error":{"message":"model_not_found"}}', "")
+            return self.success(command, **kwargs)
+        runner = app.CodexRunner("codex", {"codex_fallback_routes": [{"model": "backup", "provider": "configured"}]})
+        with patch.object(app.CodexRunner, "run_command", side_effect=execute), patch.object(app.time, "sleep"):
+            result = runner.content_review(self.workspace, {}, {})
+        self.assertTrue(result["ok"])
+        self.assertIn("backup", calls[1])
+
+    def test_timeout_retries_are_bounded_and_never_content_manual(self):
+        with patch.object(app.CodexRunner, "run_command", side_effect=subprocess.TimeoutExpired("codex", 1)) as invoke, patch.object(app.time, "sleep"):
+            result = app.CodexRunner("codex").content_review(self.workspace, {}, {})
+        self.assertEqual(invoke.call_count, 3)
+        self.assertEqual(result["verdict"], "ERROR")
+        self.assertEqual(result["error_code"], "E_CODEX_TIMEOUT")
+        self.assertEqual(len(list((self.workspace / "codex-attempts").iterdir())), 3)
+
+    def test_real_manual_judgment_is_preserved_without_retries(self):
+        def execute(command, **kwargs):
+            completed = self.success(command, **kwargs)
+            Path(command[command.index("-o") + 1]).write_text('{"verdict":"MANUAL","reason":"用途含义不明"}')
+            return completed
+        with patch.object(app.CodexRunner, "run_command", side_effect=execute) as invoke:
+            result = app.CodexRunner("codex").content_review(self.workspace, {}, {})
+        self.assertTrue(result["ok"])
+        self.assertEqual(result["verdict"], "MANUAL")
+        self.assertEqual(invoke.call_count, 1)
+
+    def test_valid_json_without_completed_turn_does_not_pass(self):
+        def execute(command, **kwargs):
+            self.success(command, **kwargs)
+            return subprocess.CompletedProcess(command, 0, '{"type":"turn.failed"}', "")
+        with patch.object(app.CodexRunner, "run_command", side_effect=execute), patch.object(app.time, "sleep"):
+            result = app.CodexRunner("codex").content_review(self.workspace, {}, {})
+        self.assertFalse(result["ok"])
+        self.assertEqual(result["verdict"], "ERROR")
+
+    def test_incomplete_worker_is_service_error_and_job_can_be_retried(self):
+        runtime = app.Runtime.__new__(app.Runtime)
+        runtime.store = Mock()
+        job_id = "test-job"
+        job = {"status": "queued", "batch_id": "test-batch"}
+        runtime.store.job.return_value = job
+        runtime.store.update_job.side_effect = lambda _, **fields: job.update(fields)
+        class IncompleteReviewer:
+            def run(self, *_):
+                return None
+        runtime.reviewer = IncompleteReviewer()
+        runtime.safe_run_review(job_id)
+        self.assertEqual(job["status"], "service_error")
+        self.assertEqual(job["error_code"], "E_INTERNAL_INCOMPLETE")
+        self.assertFalse(job["passed"])
+
+    def test_timeout_terminates_wrapper_and_native_child_group(self):
+        pid_file = self.workspace / "child.pid"
+        program = (
+            "import subprocess,sys,time,pathlib; "
+            "p=subprocess.Popen([sys.executable,'-c','import time; time.sleep(60)']); "
+            "pathlib.Path(sys.argv[1]).write_text(str(p.pid)); time.sleep(60)"
+        )
+        with self.assertRaises(subprocess.TimeoutExpired):
+            app.CodexRunner("unused").run_command(
+                [sys.executable, "-c", program, str(pid_file)], input="", timeout=0.5,
+            )
+        pid = pid_file.read_text()
+        state = subprocess.run(["ps", "-p", pid, "-o", "stat="], capture_output=True, text=True).stdout.strip()
+        self.assertTrue(not state or state.startswith("Z"), "native child is still running")
+
+
+if __name__ == "__main__":
