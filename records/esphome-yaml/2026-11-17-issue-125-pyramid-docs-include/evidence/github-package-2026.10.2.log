m5_atoms3_voice_ui:
  id: atoms3r_voice_ui
  display_id: atoms3r_lcd
  voice_assistant_id: va
  frame_delay: 33ms
  phase_id: voice_assistant_phase
  phase_mapping:
    idle: 1
    listening: 2
    thinking: 3
    replying: 4
    loading: 10
    error: 11
    muted: 12
    timer_finished: 20
  animations:
    idle: $WORK/dashimport/.esphome/m5_atoms3_voice_ui/9eb9d102
    listening: $WORK/dashimport/.esphome/m5_atoms3_voice_ui/5e06d37c
    thinking: $WORK/dashimport/.esphome/m5_atoms3_voice_ui/16c6126f
    replying: $WORK/dashimport/.esphome/m5_atoms3_voice_ui/d03b9e10
    loading: $WORK/dashimport/.esphome/m5_atoms3_voice_ui/2f540c44
    error: $WORK/dashimport/.esphome/m5_atoms3_voice_ui/5e8e4fb0
  background_color: 0x10131A
script:
  - id: start_wake_word
    then:
      - if:
          condition:
            and:
              - lambda: !lambda |-
                  return !id(init_in_progress);
              - switch.is_off:
                  id: mute
              - lambda: !lambda |-
                  return !id(mww).is_running();
          then:
            - micro_wake_word.start: {}
    mode: single
    parameters: {}
  - id: pyramid_volume_up
    then:
      - media_player.volume_up:
          id: external_media_player
          announcement: false
    mode: single
    parameters: {}
  - id: pyramid_volume_down
    then:
      - media_player.volume_down:
          id: external_media_player
          announcement: false
    mode: single
    parameters: {}
  - id: pyramid_brightness_up
    then:
      - if:
          condition:
            light.is_on:
              id: pyramid_rgb1
          then:
            - light.dim_relative:
                id: pyramid_rgb1
                relative_brightness: 0.05
                transition_length: 0ms
      - if:
          condition:
            light.is_on:
              id: pyramid_rgb2
          then:
            - light.dim_relative:
                id: pyramid_rgb2
                relative_brightness: 0.05
                transition_length: 0ms
    mode: single
    parameters: {}
  - id: pyramid_brightness_down
    then:
      - if:
          condition:
            light.is_on:
              id: pyramid_rgb1
          then:
            - light.dim_relative:
                id: pyramid_rgb1
                relative_brightness: -0.05
                transition_length: 0ms
      - if:
          condition:
            light.is_on:
              id: pyramid_rgb2
          then:
            - light.dim_relative:
                id: pyramid_rgb2
                relative_brightness: -0.05
                transition_length: 0ms
    mode: single
    parameters: {}
  - id: control_pyramid_leds
    then:
      - lambda: !lambda |-
          const int phase = id(voice_assistant_phase);
          const auto media_state = id(external_media_player).state;

          float red = 0.0f;
          float green = 0.0f;
          float blue = 0.0f;
          bool on = false;

          if (id(timer_ringing).state) {
            red = 1.0f; green = 0.2f; blue = 0.0f; on = true;
          } else if (phase == 2) {
            red = 0.0f; green = 0.75f; blue = 1.0f; on = true;
          } else if (phase == 4) {
            red = 0.55f; green = 0.10f; blue = 1.0f; on = true;
          } else if (phase == 3) {
            red = 0.0f; green = 0.65f; blue = 1.0f; on = true;
          } else if (phase == 11) {
            red = 1.0f; green = 0.0f; blue = 0.0f; on = true;
          } else if (media_state == media_player::MediaPlayerState::MEDIA_PLAYER_STATE_PLAYING ||
                     media_state == media_player::MediaPlayerState::MEDIA_PLAYER_STATE_ANNOUNCING) {
            red = 1.0f; green = 0.35f; blue = 0.0f; on = true;
          } else if (id(mute).state || phase == 12 ||
                     phase == 10) {
            red = 0.35f; green = 0.0f; blue = 0.0f; on = true;
          }

          auto apply = [&](auto *light) {
            if (!on) {
              auto call = light->turn_off();
              call.set_transition_length(0);
              call.perform();
              return;
            }
            auto call = light->turn_on();
            call.set_rgb(red, green, blue);
            call.set_transition_length(0);
            call.perform();
          };
          apply(id(pyramid_rgb1));
          apply(id(pyramid_rgb2));
    mode: single
    parameters: {}
  - id: ring_timer
    then:
      - script.execute:
          id: enable_repeat_one
      - script.execute:
          id: play_sound
          priority: true
          sound_file: timer_finished_sound
    mode: single
    parameters: {}
  - id: enable_repeat_one
    then:
      - media_player.repeat_one:
          id: external_media_player
          announcement: true
      - speaker_source.set_playlist_delay:
          id: external_media_player
          pipeline: announcement
          delay: 500ms
    mode: single
    parameters: {}
  - id: disable_repeat
    then:
      - media_player.repeat_off:
          id: external_media_player
          announcement: true
      - speaker_source.set_playlist_delay:
          id: external_media_player
          pipeline: announcement
          delay: 0ms
    mode: single
    parameters: {}
  - id: set_idle_or_mute_phase
    then:
      - lambda: !lambda |-
          if (id(timer_ringing).state) {
            id(voice_assistant_phase) = 20;
          } else if (id(va).get_api_connection() == nullptr) {
            id(voice_assistant_phase) = 10;
          } else {
            id(voice_assistant_phase) = id(mute).state
              ? 12 : 1;
          }
    mode: single
    parameters: {}
  - id: play_sound
    parameters:
      priority: bool
      sound_file: string
    then:
      - if:
          condition:
            lambda: !lambda |-
              return priority;
          then:
            - media_player.stop:
                id: external_media_player
                announcement: true
      - lambda: !lambda |-
          if ( (id(external_media_player).state != media_player::MediaPlayerState::MEDIA_PLAYER_STATE_ANNOUNCING ) || priority) {
            id(external_media_player)
              ->make_call()
              .set_media_url("audio-file://" + sound_file)
              .set_announcement(true)
              .perform();
          }
    mode: single

INFO Configuration is valid!
