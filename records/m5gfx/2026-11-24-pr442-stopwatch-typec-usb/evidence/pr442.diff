+// G1 selects the USB destination on StopWatch V1.1: low keeps Type-C connected.
+static void test_stopwatch_typec_usb_default()
+{
+  for (std::uint8_t initial_mode : { 0x00, 0xFF })
+    for (std::uint8_t initial_output : { 0x00, 0xFF })
+      for (std::uint8_t initial_drive : { 0x00, 0xFF })
+      {
+        fake_t fake;
+        fake.registers[{0x4F, 0x03}] = initial_mode;
+        fake.registers[{0x4F, 0x05}] = initial_output;
+        fake.registers[{0x4F, 0x13}] = initial_drive;
+        static const std::int8_t pins[] = { 39 };
+        const bdops::gpio_scope_t scope = { 49, pins, 1 };
+        const auto sequence = bdops::list(pmicops::stopwatch_power_on);
+        assert(bdops::run_ops(ports, 1, pmicops::pm1_family_devices, 2,
+                             sequence.data, sequence.size, scope).status == bdops::op_status_t::ok);
+
+        // Preload low before enabling output/drive, including a retained high latch.
+        std::uint8_t output = initial_output;
+        for (const auto& write : fake.writes)
+        {
+          if (write.addr != 0x4F) { continue; }
+          if (write.reg == 0x05) { output = write.new_value; }
+          if (write.reg == 0x03 || write.reg == 0x05 || write.reg == 0x13)
+          {
+            assert((output & 0x01) == 0);
+          }
+        }
+        assert((fake.registers[std::make_pair(0x4F, 0x03)] & 0x01) != 0);
+        assert((fake.registers[std::make_pair(0x4F, 0x13)] & 0x01) == 0);
+        // Display/TP reset and LCD power stay enabled; unrelated G2/G6/G7 stay intact.
+        assert((output & 0x98) == 0x98);
+        assert((output & 0x62) == (initial_output & 0x62));
+      }
+}
