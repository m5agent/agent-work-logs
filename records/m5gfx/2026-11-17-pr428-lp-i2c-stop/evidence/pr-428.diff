+        gpio::release_lp_pad(pin_sda);
+        gpio::release_lp_pad(pin_scl);
+        pinMode(pin_sda, pin_mode_t::input_pullup);  // selects the GPIO function of the pads
+        pinMode(pin_scl, pin_mode_t::input_pullup);
+      }
+#endif
       i2c_stop(i2c_port);
 
 #if LGFX_LP_I2C_NUM > 0
