diff --git a/hw/misc/esp32_ledc_ir_capture.h b/hw/misc/esp32_ledc_ir_capture.h
new file mode 100644
index 0000000000000000000000000000000000000000..135d319e8428d5277e95cb8d40ad34ead69e4e45
--- /dev/null
+++ b/hw/misc/esp32_ledc_ir_capture.h
@@ -0,0 +1,125 @@
+/*
+ * Read-only envelope observation for the Cardputer-ADV IR output.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_MISC_ESP32_LEDC_IR_CAPTURE_H
+#define HW_MISC_ESP32_LEDC_IR_CAPTURE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define LEDC_IR_GPIO 44
+#define LEDC_IR_SIGNAL0 73
+#define LEDC_IR_CHANNELS 8
+#define LEDC_IR_EDGES 192
+
+enum {
+    LEDC_IR_CHANNEL_STRIDE = 0x14,
+    LEDC_IR_DUTY = 0x08,
+    LEDC_IR_CONF1 = 0x0c,
+    LEDC_IR_TIMER0_CONF = 0xa0,
+    LEDC_IR_CLOCK_CONF = 0xd0,
+    LEDC_IR_SIG_OUT_EN = 1u << 2,
+    LEDC_IR_CHANNEL_PARA_UP = 1u << 4,
+    LEDC_IR_TIMER_PAUSE = 1u << 22,
+    LEDC_IR_TIMER_RESET = 1u << 23,
+    LEDC_IR_TIMER_PARA_UP = 1u << 25,
+};
+
+#define LEDC_IR_DUTY_START UINT32_C(0x80000000)
+
+typedef struct Esp32LedcIrChannel {
+    uint32_t requested_duty;
+    uint32_t applied_duty;
+    uint32_t conf0;
+    bool duty_start;
+} Esp32LedcIrChannel;
+
+typedef struct Esp32LedcIrEdge {
+    int64_t at_ns;
+    uint32_t carrier_hz;
+    uint32_t duty_count;
+    uint32_t period_count;
+} Esp32LedcIrEdge;
+
+typedef struct Esp32LedcIrWaveform {
+    Esp32LedcIrChannel channels[LEDC_IR_CHANNELS];
+    uint32_t timer_conf[4];
+    uint32_t clock_conf;
+    uint64_t edges_written;
+    Esp32LedcIrEdge edges[LEDC_IR_EDGES];
+} Esp32LedcIrWaveform;
+
+static void esp32_ledc_ir_write(Esp32LedcIrWaveform *s, uint32_t addr,
+                               uint32_t value)
+{
+    if (addr < LEDC_IR_TIMER0_CONF) {
+        Esp32LedcIrChannel *channel = &s->channels[addr / LEDC_IR_CHANNEL_STRIDE];
+
+        switch (addr % LEDC_IR_CHANNEL_STRIDE) {
+        case LEDC_IR_DUTY:
+            channel->requested_duty = (value & 0x7ffff) >> 4;
+            channel->duty_start = false;
+            break;
+        case LEDC_IR_CONF1:
+            channel->duty_start = (value & LEDC_IR_DUTY_START) != 0;
+            break;
+        case 0:
+            if (value & LEDC_IR_CHANNEL_PARA_UP) {
+                channel->conf0 = value;
+                if (channel->duty_start) {
+                    channel->applied_duty = channel->requested_duty;
+                } else if (!(value & LEDC_IR_SIG_OUT_EN)) {
+                    channel->applied_duty = 0;
+                }
+                channel->duty_start = false;
+            }
+            break;
+        }
+    } else if (addr < LEDC_IR_TIMER0_CONF + 4 * 8 && (addr & 7) == 0) {
+        uint32_t *timer = &s->timer_conf[(addr - LEDC_IR_TIMER0_CONF) / 8];
+        uint32_t run_mask = LEDC_IR_TIMER_PAUSE | LEDC_IR_TIMER_RESET;
+
+        *timer = (value & LEDC_IR_TIMER_PARA_UP) ? value
+                 : (*timer & ~run_mask) | (value & run_mask);
+    } else if (addr == LEDC_IR_CLOCK_CONF) {
+        s->clock_conf = value;
+    }
+}
+
+static void esp32_ledc_ir_sample(Esp32LedcIrWaveform *s, int channel,
+                                int64_t now)
+{
+    Esp32LedcIrEdge edge = { .at_ns = now };
+
+    /* The S3 HAL selects XTAL through CONF[1:0]; its enable_clock is a no-op. */
+    if (channel >= 0 && channel < LEDC_IR_CHANNELS && (s->clock_conf & 3) == 3) {
+        const Esp32LedcIrChannel *c = &s->channels[channel];
+        uint32_t timer = s->timer_conf[c->conf0 & 3];
+        unsigned resolution = timer & 15;
+        unsigned divider = (timer >> 4) & 0x3ffff;
+        unsigned period = 1u << resolution;
+
+        if (resolution && divider >= 256 && (c->conf0 & LEDC_IR_SIG_OUT_EN) &&
+            !(timer & (LEDC_IR_TIMER_PAUSE | LEDC_IR_TIMER_RESET)) &&
+            c->applied_duty > 0 && c->applied_duty < period) {
+            uint64_t clocks = (uint64_t)divider * period;
+            edge.carrier_hz = (UINT64_C(40000000) * 256 + clocks / 2) / clocks;
+            edge.duty_count = c->applied_duty;
+            edge.period_count = period;
+        }
+    }
+
+    const Esp32LedcIrEdge *previous = s->edges_written ?
+        &s->edges[(s->edges_written - 1) % LEDC_IR_EDGES] : NULL;
+    if (previous ? previous->carrier_hz == edge.carrier_hz &&
+                   previous->duty_count == edge.duty_count &&
+                   previous->period_count == edge.period_count
+                 : !edge.carrier_hz) {
+        return;
+    }
+    s->edges[s->edges_written++ % LEDC_IR_EDGES] = edge;
+}
+
+#endif /* HW_MISC_ESP32_LEDC_IR_CAPTURE_H */
